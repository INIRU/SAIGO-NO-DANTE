    },
    {
      "id": 5,
      "teller": "홍루",
      "title": null,
      "content": "동백이는 항상 얼굴에 그늘이 져 보여서 신경이 많이 쓰였는데…",
      "place": null,
      "activeCGs": [],
      "effect": null
    },
    {
      "id": 6,
      "teller": "홍루",
      "title": null,
