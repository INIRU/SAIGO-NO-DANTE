  "lines": [
    {
      "id": 0,
      "teller": null,
      "title": null,
      "content": "끝나지 않을 것 같던 고통의 굴레도 결국 지나갔고…",
      "place": null,
      "activeCGs": [],
      "effect": null
    },
    {
      "id": 1,
      "teller": "파우스트",
      "title": null,
      "content": "환상체 제압이 무사히 끝났군요. 버스로 복귀해도 되겠어요.",
      "place": "난장판이 된 K사 거리",
      "activeCGs": [],
      "effect": null
    },
    {
      "id": 2,
      "teller": null,
      "title": null,
      "content": "무사히라고 말하기엔 수많은 죽음과 부활이 생략된 것 같지만, 일단은 고개를 끄덕였다.",
      "place": null,
      "activeCGs": [],
      "effect": null
    },
    {
      "id": 3,
      "teller": null,
      "title": null,
      "content": "찝찝한 점들을 몇 가지 남겨둔 채로 우리는 다시 버스에 올라왔다.",
      "place": null,
      "activeCGs": [],
      "effect": null
    },
    {
      "id": 4,
      "teller": "베르길리우스",
      "title": null,
      "content": "예상보다 늦었군. 오래간만에 낮잠이란 걸 자볼까 생각하던 참이었는데 말이지.",
      "place": "메피스토펠레스 내부",
      "activeCGs": [],
      "effect": null
    },
    {
      "id": 5,
      "teller": null,
      "title": null,
      "content": "베르길리우스에게 아까 있었던 이상한 일들에 대해서 설명했다. (정확히는, 파우스트가 전달해 주었다.)",
      "place": null,
      "activeCGs": [],
      "effect": null
    },
    {
      "id": 6,
      "teller": null,
      "title": null,
      "content": "싸늘한 대답과 함께, '시키는 대로나 하시지요, 관리자 단테.' 따위의 대답이 돌아올 줄 알았지만, 의외로 그의 입에서는 건실한 답변이 튀어나왔다.",
      "place": null,
      "activeCGs": [],
      "effect": null
    },
    {
      "id": 7,
      "teller": "베르길리우스",
      "title": null,
      "content": "…환상체 라는 존재가 세간에 거의 알려지지 않았던 존재이니만큼, 자세한 정보까지 쥐고 있는 것은 아닙니다. 단테.",
      "place": null,
      "activeCGs": [],
      "effect": null
    },
    {
      "id": 8,
      "teller": "단테",
      "title": null,
      "content": "<의외로 순순히 인정하네?>",
      "place": null,
      "activeCGs": [],
      "effect": null
    },
    {
      "id": 9,
      "teller": null,
      "title": null,
      "content": "파우스트가 움찔거렸지만, 굳이 그 말까지 전달하지는 않았다.",
      "place": null,
      "activeCGs": [],
      "effect": null
    },
    {
      "id": 10,
      "teller": "베르길리우스",
      "title": null,
      "content": "그런 건… 추후에 파우스트 씨 쪽에서 잘난 우리 림버스 컴퍼니의 다른 부서들과 함께 속 시원히 밝혀줄 거라고 기대해 보지 않겠습니까.",
      "place": null,
      "activeCGs": [],
      "effect": null
    },
    {
      "id": 11,
      "teller": "파우스트",
      "title": null,
      "content": "…그러죠.",
      "place": null,
      "activeCGs": [],
      "effect": null
    },
    {
      "id": 12,
      "teller": null,
      "title": null,
      "content": "파우스트가 여기서 연구를 할 수 있는 시간이라는 게 있었나?",
      "place": null,
      "activeCGs": [],
      "effect": null
    },
    {
      "id": 13,
      "teller": null,
      "title": null,
      "content": "결국 수수께끼는 풀리지 않았지만… 흔쾌히 파우스트가 대답했다는 건 뭔가 방법이 떠오른 거겠지.",
      "place": null,
      "activeCGs": [],
      "effect": null
    },
    {
      "id": 14,
      "teller": "오티스",
      "title": null,
      "content": "거기, 왜 아까부터 자꾸 어깨를 움츠리고 다니는 거지?",
      "place": null,
      "activeCGs": [],
      "effect": null
    },
    {
      "id": 15,
      "teller": "오티스",
      "title": null,
      "content": "가뜩이나 조그맣던 통에 어깨까지 수그리고 다니니까 아예 보이지도 않는군.",
      "place": null,
      "activeCGs": [],
      "effect": null
    },
    {
      "id": 16,
      "teller": "돈키호테",
      "title": null,
      "content": "…지크프리드 님을 다시 만날 수 있을 줄 알았소…",
      "place": null,
      "activeCGs": [],
      "effect": null
    },
    {
      "id": 17,
      "teller": "그레고르",
      "title": null,
      "content": "(지크…프리드 님이 누구셨더라?)",
      "place": null,
      "activeCGs": [],
      "effect": null
    },
    {
      "id": 18,
      "teller": "이스마엘",
      "title": null,
      "content": "한 손으로는 저희를 베어가면서 다른 한 손으로는 기념사진을 찍었던 놈 아닌가요?",
      "place": null,
      "activeCGs": [],
      "effect": null
    },
    {
      "id": 19,
      "teller": "그레고르",
      "title": null,
      "content": "(아… 자크프리더…?)",
      "place": null,
      "activeCGs": [],
      "effect": null
    },
    {
      "id": 20,
      "teller": null,
      "title": null,
      "content": "이스마엘은 아직도 그 사건이 인상 깊게 박혀 있는 듯 콧김이 식식거리는 소리가 들렸다.",
      "place": null,
      "activeCGs": [],
      "effect": null
    },
    {
      "id": 21,
      "teller": "돈키호테",
      "title": null,
      "content": "본인이 사람들을 구하는 모습… 지크프리드 님께도 보여드리려고 했단 말이오…",
      "place": null,
      "activeCGs": [],
      "effect": null
    },
    {
      "id": 22,
      "teller": "돈키호테",
      "title": null,
      "content": "나중에 훌륭한 해결사가 되어서 만나기로 약속도 했는데…",
      "place": null,
      "activeCGs": [],
      "effect": null
    },
    {
      "id": 23,
      "teller": "그레고르",
      "title": null,
      "content": "그런 건 오랜 시간이 지난 후 재회해야 감격이 큰 법이야, 돈키호테. 차라리 잘 됐다고 생각해 보자구.",
      "place": null,
      "activeCGs": [],
      "effect": null
    },
    {
      "id": 24,
      "teller": "베르길리우스",
      "title": null,
      "content": "확실히 어색하긴 하군.",
      "place": null,
      "activeCGs": [],
      "effect": null
    },
    {
      "id": 25,
      "teller": "베르길리우스",
      "title": null,
      "content": "구경꾼이 많은 곳에서 벌어진 사건엔 그자가 빠질 리 없는데.",
      "place": null,
      "activeCGs": [],
      "effect": null
    },
    {
      "id": 26,
      "teller": "홍루",
      "title": null,
      "content": "오호… 흔히 말하는 연예인 같은 분인가요?",
      "place": null,
      "activeCGs": [],
      "effect": null
    },
    {
      "id": 27,
      "teller": "베르길리우스",
      "title": null,
      "content": "비슷한 것 같군. 그자는 쇼맨쉽에 특화 되어 있으니, 보통 K사에서는 이럴 때 반드시 내보내지.",
      "place": null,
      "activeCGs": [],
      "effect": null
    },
    {
      "id": 28,
      "teller": "베르길리우스",
      "title": null,
      "content": "하지만… 모든 이목을 다 끌 수 있었던 사건에서 그자가 나타나지 않았다는 건.",
      "place": null,
      "activeCGs": [],
      "effect": null
    },
    {
      "id": 29,
      "teller": "단테",
      "title": null,
      "content": "<이목을 끌어서는 안 되는 사건이라는 건가…>",
      "place": null,
      "activeCGs": [],
      "effect": null
    },
    {
      "id": 30,
      "teller": "돈키호테",
      "title": null,
      "content": "지크프리드 님을… 그런 식으로 폄하하지 마시오!",
      "place": null,
      "activeCGs": [],
      "effect": null
    },
    {
      "id": 31,
      "teller": "돈키호테",
      "title": null,
      "content": "그분이 냈던 자서전, ‘영웅이란 모름지기 마지막까지 웃어야 한다.', 42 페이지 5번째 줄을 보면 때와 장소를 가리지 않고 약자들을 구하러 갈 것이라고 써 있었소!",
      "place": null,
      "activeCGs": [],
      "effect": null
    },
    {
      "id": 32,
      "teller": "베르길리우스",
      "title": null,
      "content": "…하. 그래, 그 신념 부디 잘 간직하고 있으라고.",
      "place": null,
