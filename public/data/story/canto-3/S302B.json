      "effect": null
    },
    {
      "id": 7,
      "teller": "로쟈",
      "title": null,
      "content": "난 K사 비자 없는데. 나 빼고 다들 있는 거 아니지?",
      "place": null,
      "activeCGs": [],
      "effect": null
    },
    {
      "id": 8,
      "teller": "히스클리프",
      "title": null,
      "content": "뭐냐. 왜 날 보냐?",
