  "lines": [
    {
      "id": 0,
      "teller": "유리",
      "title": "8급 해결사",
      "content": "카론, 이쪽이 동쪽일까요, 서쪽일까요?",
      "place": "메피스토펠레스 내부",
      "activeCGs": [],
      "effect": null
    },
    {
      "id": 1,
      "teller": "카론",
      "title": null,
      "content": "카론은 두 가지 방향만 알아. 메피의 앞쪽과 뒤쪽.",
      "place": null,
      "activeCGs": [],
      "effect": null
    },
    {
      "id": 2,
      "teller": "유리",
      "title": "8급 해결사",
      "content": "지금까지 방향도 모르는 사람이 어떻게 운전기사를 했대요?",
      "place": null,
      "activeCGs": [],
      "effect": null
    },
    {
      "id": 3,
      "teller": "싱클레어",
      "title": null,
      "content": "카론… 그러니까요, 해가 뜨는 쪽이…",
      "place": null,
      "activeCGs": [],
      "effect": null
    },
    {
      "id": 4,
      "teller": null,
      "title": null,
      "content": "버스의 운전석에는 세 명의 머리가 서로 맞대고 지도를 들여다보고 있었다.",
      "place": null,
      "activeCGs": [],
      "effect": null
    },
    {
      "id": 5,
      "teller": null,
      "title": null,
      "content": "아니, 한 명은 그렇게 맞닿아 있지 않을지도 모르겠다.",
      "place": null,
      "activeCGs": [],
      "effect": null
    },
    {
      "id": 6,
      "teller": "로쟈",
      "title": null,
      "content": "풉… 꼬맹이~ 너도 저기 끼어 있어야 하는 거 아니야?",
      "place": null,
      "activeCGs": [],
      "effect": null
    },
    {
      "id": 7,
      "teller": "돈키호테",
      "title": null,
      "content": "무례한 소리! 난 어린이가 아니라네! 꼬맹이는 더더욱 아니고!",
      "place": null,
      "activeCGs": [],
      "effect": null
    },
    {
      "id": 8,
      "teller": null,
      "title": null,
      "content": "주먹을 하늘에 붕붕 돌리면서 로쟈에게 반응하고 있는 돈키호테를 보다가, 문득 씁쓸한 표정으로 그들을 쳐다보는 자가 시야에 들어왔다.",
      "place": null,
      "activeCGs": [],
      "effect": null
    },
    {
      "id": 9,
      "teller": "단테",
      "title": null,
      "content": "<…유리도 어린 나이부터 좋지 않은 경험을 했나 봐.>",
      "place": null,
      "activeCGs": [],
      "effect": null
    },
    {
      "id": 10,
      "teller": null,
      "title": null,
      "content": "그레고르는 잠시 뒤를 돌아 내가 있는 쪽을 쓱 쳐다보더니, 고개를 절레절레 저으며 다시 턱을 괴고 운전석을 바라보았다.",
      "place": null,
      "activeCGs": [],
      "effect": null
    },
    {
      "id": 11,
      "teller": "그레고르",
      "title": null,
      "content": "…딱히 어린 편도 아니야. 일단 칼을 쥘 수 있으면 전쟁에 참전부터 시키는 둥지도 있었으니까.",
      "place": null,
      "activeCGs": [],
      "effect": null
    },
    {
      "id": 12,
      "teller": null,
      "title": null,
      "content": "둥지… 실질적으로 어느 구획의 핵심구역이라고 설명했던 것이 기억난다.",
      "place": null,
      "activeCGs": [],
      "effect": null
    },
    {
      "id": 13,
      "teller": null,
      "title": null,
      "content": "과거에는 둥지끼리 전쟁이라도 벌였던 모양이군.",
      "place": null,
      "activeCGs": [],
      "effect": null
    },
    {
      "id": 14,
      "teller": "단테",
      "title": null,
      "content": "<그런 일이 흔했어?>",
      "place": null,
      "activeCGs": [],
      "effect": null
    },
    {
      "id": 15,
      "teller": "그레고르",
      "title": null,
      "content": "아주 없는 일은 아니었지.",
      "place": null,
      "activeCGs": [],
      "effect": null
    },
    {
      "id": 16,
      "teller": "그레고르",
      "title": null,
      "content": "…관리자 양반, 전쟁에 대해 궁금한 게 많나 봐?",
      "place": null,
      "activeCGs": [],
      "effect": null
    },
    {
      "id": 17,
      "teller": "단테",
      "title": null,
      "content": "<아, 궁금하다기보다는 관리자가 알아야 할 법한 정보를 주워 모으려고…>",
      "place": null,
      "activeCGs": [],
      "effect": null
    },
    {
      "id": 18,
      "teller": null,
      "title": null,
      "content": "말을 더 이으려다가, 옆으로 언뜻 보이는 그레고르의 표정이 그만 말문을 막히게 만들었다.",
      "place": null,
      "activeCGs": [],
      "effect": null
    },
    {
      "id": 19,
      "teller": null,
      "title": null,
      "content": "그의 눈은, 이미 운전석이 아닌 머나먼 어딘가를 보고 있는 것만 같았다.",
      "place": null,
      "activeCGs": [],
      "effect": null
    },
    {
      "id": 20,
      "teller": "그레고르",
      "title": null,
      "content": "그런 자세를 뭐라고 하고 싶은 건 아냐, 관리자 양반. 오히려 좋은 자세 아닐까? 상관의 귀감 아닐까 싶은데.",
      "place": null,
      "activeCGs": [],
      "effect": null
    },
    {
      "id": 21,
      "teller": null,
      "title": null,
      "content": "그는 가슴 주머니에서 담뱃갑을 꺼내 들며, 천천히 말을 이어 나갔다.",
      "place": null,
      "activeCGs": [],
      "effect": null
    },
    {
      "id": 22,
      "teller": "그레고르",
      "title": null,
      "content": "그래도, 개인적으로는 모를 수 있을 때 모르는 게 기회일지도 모른다고 생각해.",
      "place": null,
      "activeCGs": [],
      "effect": null
    },
    {
      "id": 23,
      "teller": "그레고르",
      "title": null,
      "content": "일단 알게 되면, 다시는 모를 수 없게 될 테니까.",
      "place": null,
      "activeCGs": [],
      "effect": null
    },
    {
      "id": 24,
      "teller": null,
      "title": null,
      "content": "그러고는 더 말이 없이, 그는 담배에 불을 붙였다.",
      "place": null,
      "activeCGs": [],
      "effect": null
    },
    {
      "id": 25,
      "teller": "유리",
      "title": "8급 해결사",
      "content": "아뇨, 방금 저 쪽에서 우회전을 했어야죠!",
      "place": null,
      "activeCGs": [],
      "effect": null
    },
    {
      "id": 26,
      "teller": "싱클레어",
      "title": null,
      "content": "괘, 괜찮아요. 카론. 조금만 더 가서 꺾어도 올바른 길로 갈 수 있어요.",
      "place": null,
      "activeCGs": [],
      "effect": null
    },
    {
      "id": 27,
      "teller": "카론",
      "title": null,
      "content": "아아… 기사의 삶은 고단해.",
      "place": null,
      "activeCGs": [],
      "effect": null
    },
    {
      "id": 28,
      "teller": "그레고르",
      "title": null,
      "content": "뭐… 지금 더 급한 건 목적지로 가는 길을 아는 것 같네. 그렇지, 관리자 양반?",
      "place": null,
      "activeCGs": [],
      "effect": null
    },
    {
      "id": 29,
      "teller": null,
      "title": null,
      "content": "그레고르는 담배 연기 째로 피시식 웃으며 너스레를 떨었다.",
      "place": null,
      "activeCGs": [],
      "effect": null
    },
    {
      "id": 30,
      "teller": null,
      "title": null,
      "content": "그에게 어떤 일이 있었는지는 여전히 궁금하지만, 일단은 다른 데에 신경 쓰는 것이 나을 것 같다.",
      "place": null,
      "activeCGs": [],
      "effect": null
    },
    {
      "id": 31,
      "teller": null,
      "title": null,
      "content": "안 그래도, 신경 써야 할 만한 일이 눈앞(정확히는 버스 앞)으로 다가온 것 같으니까.",
      "place": null,
      "activeCGs": [],
      "effect": null
    },
    {
      "id": 32,
      "teller": "베르길리우스",
      "title": null,
      "content": "옥신각신은 그쯤 해라. 전방에 다시 적이다.",
      "place": null,
      "activeCGs": [],
      "effect": null
    },
    {
      "id": 33,
      "teller": "대가리 불한당",
      "title": "4구 뒷골목",
      "content": "내 친구들을 버스에 쳐 넣다니, 미친 새끼들! 제정신이야?",
      "place": null,
      "activeCGs": [],
