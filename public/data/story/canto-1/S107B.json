    },
    {
      "id": 35,
      "teller": "카론",
      "title": null,
      "content": "베르, 연료들이 시끄러워. 카론, 두 명 이상 시끄러우면 어지러워.",
      "place": null,
      "activeCGs": [],
      "effect": null
    },
    {
      "id": 36,
      "teller": "베르길리우스",
      "title": null,
