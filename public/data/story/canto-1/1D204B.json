  "lines": [
    {
      "id": 0,
      "teller": "단테",
      "title": null,
      "content": "<방금 그 환상체가 직원들을 전부 죽였던 걸까?>",
      "place": "4구 로보토미 지부 어딘가",
      "activeCGs": [],
      "effect": null
    },
    {
      "id": 1,
      "teller": "유리",
      "title": "8급 해결사",
      "content": "아니에요. 아마 제 짐작이 맞다면…",
      "place": null,
      "activeCGs": [],
      "effect": null
    },
    {
      "id": 2,
      "teller": "오티스",
      "title": null,
      "content": "전방을 주시하십쇼, 관리자님. 아까랑 똑같은 놈이 하나 더 있습니다.",
      "place": null,
      "activeCGs": [],
      "effect": null
    },
    {
      "id": 3,
      "teller": null,
      "title": null,
      "content": "복도 끝에 석상 머리를 쓴 무언가가 힘없이 기대어 앉아있다.",
      "place": null,
      "activeCGs": [],
      "effect": null
    },
    {
      "id": 4,
      "teller": "석상 머리",
      "title": "생존자?",
      "content": "안녕…? 너희도… 제비뽑기를… 하러 왔니…",
      "place": null,
      "activeCGs": [],
      "effect": null
    },
    {
      "id": 5,
      "teller": "석상 머리",
      "title": "생존자?",
      "content": "사원증을… 다 모아서… 주면… 당첨자를 고르는 거야.",
      "place": null,
      "activeCGs": [],
      "effect": null
    },
    {
      "id": 6,
      "teller": null,
      "title": null,
      "content": "손에는 사원증이 달린 줄만 간신히 쥐고 있었다. 알렉스라는 이름이 보였다.",
      "place": null,
      "activeCGs": [],
      "effect": null
    },
    {
      "id": 7,
      "teller": "유리",
      "title": "8급 해결사",
      "content": "…알렉스.",
      "place": null,
      "activeCGs": [],
      "effect": null
    },
    {
      "id": 8,
      "teller": "히스클리프",
      "title": null,
      "content": "제정신이 아닌데? 당첨자 타령은 뭐야?",
      "place": null,
      "activeCGs": [],
      "effect": null
    },
    {
      "id": 9,
      "teller": "유리",
      "title": "8급 해결사",
      "content": "어떤 환상체들은… 관리법에 정기적으로 희생물을 정해 바치라고 쓰여져 있었죠.",
      "place": null,
      "activeCGs": [],
      "effect": null
    },
    {
      "id": 10,
      "teller": "석상 머리",
      "title": "생존자?",
      "content": "그쪽으로 가면 안 돼… 그것들이 곧 찾아낼 거야…",
      "place": null,
      "activeCGs": [],
      "effect": null
    },
    {
      "id": 11,
      "teller": "유리",
      "title": "8급 해결사",
      "content": "…그리고 결국 인신 공양이 있었던 거구나. 그렇지?",
      "place": null,
      "activeCGs": [],
      "effect": null
    },
    {
      "id": 12,
      "teller": "석상 머리",
      "title": "생존자?",
      "content": "네가 뽑을… 차례야…",
      "place": null,
      "activeCGs": [],
      "effect": null
    },
    {
      "id": 13,
      "teller": "단테",
      "title": null,
      "content": "<인신 공양…?>",
      "place": null,
      "activeCGs": [],
      "effect": null
    },
    {
      "id": 14,
      "teller": "이스마엘",
      "title": null,
      "content": "인신 공양을 하지 않으면 어떻게 되는데요?",
      "place": null,
      "activeCGs": [],
      "effect": null
    },
    {
      "id": 15,
      "teller": "유리",
      "title": "8급 해결사",
      "content": "그건 몰라요… 관리법은 항상 철저히 지켜졌었거든요.",
      "place": null,
      "activeCGs": [],
      "effect": null
    },
    {
      "id": 16,
      "teller": "이스마엘",
      "title": null,
      "content": "탈출해서 닥치는 대로 사람을 죽이고 다녔던 건가요.",
      "place": null,
      "activeCGs": [],
      "effect": null
    },
    {
      "id": 17,
      "teller": "히스클리프",
      "title": null,
      "content": "하! 그 환상체라는 놈, 되게 졸렬한가 보네. 만나면 뒤통수를 까고 다니나 보지?",
      "place": null,
      "activeCGs": [],
      "effect": null
    },
    {
      "id": 18,
      "teller": "유리",
      "title": "8급 해결사",
      "content": "그게… 무슨 말이에요?",
      "place": null,
      "activeCGs": [],
      "effect": null
    },
    {
      "id": 19,
      "teller": "히스클리프",
      "title": null,
      "content": "단체로 눈이 삐기라도 했냐? 그건 사람이 낸 상처였어. 서로 한 대라도 더 때리려고 기를 썼더만.",
      "place": null,
      "activeCGs": [],
      "effect": null
    },
    {
      "id": 20,
      "teller": "히스클리프",
      "title": null,
      "content": "저 등신들은 지들끼리 치고박다가 뒤진 거야.",
      "place": null,
      "activeCGs": [],
      "effect": null
    },
    {
      "id": 21,
      "teller": "유리",
      "title": "8급 해결사",
      "content": "왜, 왜 그런 건데요?",
      "place": null,
