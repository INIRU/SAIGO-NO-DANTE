{
  "name": "limbus-archive",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run build:assist-worker && npm run build:assist-ocr && next build",
    "build:assist-worker": "esbuild lib/vision/scene-worker.ts --bundle --format=esm --platform=browser --target=es2022 --outfile=public/models/assist-scene/scene-worker.js && cp node_modules/onnxruntime-web/dist/ort-wasm-simd-threaded.asyncify.mjs node_modules/onnxruntime-web/dist/ort-wasm-simd-threaded.asyncify.wasm public/models/assist-scene/",
    "fetch:assist-paddle": "node scripts/vision/fetch_paddle_ocr.mjs",
    "build:assist-ocr": "esbuild lib/vision/ocr-worker.ts --bundle --format=esm --platform=browser --target=es2022 --outfile=public/models/assist-ocr/ocr-worker.js && mkdir -p public/models/assist-ocr/core public/models/assist-ocr/lang && cp node_modules/tesseract.js/dist/worker.min.js public/models/assist-ocr/tesseract-worker.min.js && cp node_modules/tesseract.js-core/*-lstm.wasm* public/models/assist-ocr/core/ && cp node_modules/@tesseract.js-data/kor/4.0.0_best_int/kor.traineddata.gz node_modules/@tesseract.js-data/eng/4.0.0_best_int/eng.traineddata.gz node_modules/@tesseract.js-data/jpn/4.0.0_best_int/jpn.traineddata.gz public/models/assist-ocr/lang/",
    "start": "next start",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "audit:data": "tsx scripts/audit/data-integrity.ts",
    "env:pull": "vercel env pull .env.local"
  },
  "dependencies": {
    "@chenglou/pretext": "^0.0.6",
    "@esotericsoftware/spine-webgl": "~4.0.31",
    "@radix-ui/react-dialog": "^1.1.15",
    "@sentry/nextjs": "^10.54.0",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.106.2",
    "@tiptap/extension-image": "3.22.5",
    "@tiptap/extension-placeholder": "^3.22.5",
    "@tiptap/react": "^3.22.5",
    "@tiptap/starter-kit": "^3.22.5",
    "@vercel/analytics": "^1.6.1",
    "gifenc": "^1.0.3",
    "html2canvas": "^1.4.1",
    "lucide-react": "^1.7.0",
    "motion": "^12.40.0",
    "next": "^16.2.6",
    "next-auth": "^4.24.13",
    "next-intl": "^4.12.0",
    "next-seo": "^7.3.0",
    "nuqs": "^2.8.9",
    "onnxruntime-web": "^1.30.0",
    "pako": "^2.1.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "sharp": "^0.34.5",
    "sonner": "^2.0.7",
    "swr": "^2.4.1",
    "tesseract.js": "^7.0.0",
    "thumbhash": "^0.1.1",
    "zod": "^4.3.6",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@tailwindcss/postcss": "^4.2.2",
    "@tesseract.js-data/eng": "^1.0.0",
    "@tesseract.js-data/jpn": "^1.0.0",
    "@tesseract.js-data/kor": "^1.0.0",
    "@types/node": "^24.12.1",
    "@types/pako": "^2.0.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "^0.28.2",
    "playwright": "^1.59.1",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.2"
  }
}
