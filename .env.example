# Names the code reads. Copy to .env.local and fill in; real values never go into Git.

# Supabase (schema `limbus`). The secret key is server-only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Sign-in (NextAuth + Google)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ADMIN_EMAILS=

# Site
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_DISCORD_URL=
YOUTUBE_CHANNEL_ID=
# Hashes visitor addresses for discovery and rate limits.
IP_HASH_SECRET=
# Lets the sync and scripts drop cached game data (POST /api/revalidate).
REVALIDATION_SECRET=
DISCORD_ANNOUNCEMENT_WEBHOOK_URL=

# Cloudflare Web Analytics read access (home tools are ordered by visits; without both the built-in order stays).
# Token permission: Account > Account Analytics > Read.
CLOUDFLARE_ANALYTICS_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Self-hosted server only: 1 turns on HTTPS-only headers
SELF_HOSTED=
# Self-hosted behind CloudFront: the X-Origin-Verify value CloudFront sends; only then is its x-viewer-ip trusted as the visitor.
ORIGIN_VERIFY_SECRET=

# Browser push (web-push). Make a pair with `npx web-push generate-vapid-keys`; without all three nothing is pushed.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:

# Sentry (optional)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Scripts only
SITE_URL=
LIMBUS_DATA_DIR=
