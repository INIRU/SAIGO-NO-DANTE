# Names the code reads. Copy to .env.local and fill in; real values never go into Git.
# With the Vercel CLI logged in, `npm run env:pull` writes .env.local from the Vercel project instead.

# Supabase (schema `limbus`). The secret key is server-only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Sign-in (NextAuth + Google)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ADMIN_EMAILS=

# Site
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_DISCORD_URL=
YOUTUBE_CHANNEL_ID=
# Hashes visitor addresses for discovery and rate limits.
IP_HASH_SECRET=
# Lets the sync and scripts drop cached game data (POST /api/revalidate).
REVALIDATION_SECRET=
DISCORD_ANNOUNCEMENT_WEBHOOK_URL=

# Self-hosted server only: 1 turns on HTTPS-only headers (Vercel sets VERCEL=1 itself)
SELF_HOSTED=

# Browser push (web-push). Make a pair with `npx web-push generate-vapid-keys`; without all three nothing is pushed.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:

# Vercel: maintenance list in Edge Config (both needed, else the proxy reads Supabase)
EDGE_CONFIG=
VERCEL_API_TOKEN=
VERCEL_TEAM_ID=

# Sentry (optional)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Scripts only
SITE_URL=
LIMBUS_DATA_DIR=
