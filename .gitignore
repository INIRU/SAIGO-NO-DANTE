# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report
/test-results

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# typescript
*.tsbuildinfo
next-env.d.ts

# sentry
.env.sentry-build-plugin

.worktrees/

# Python-generated caches
__pycache__/
*.pyc

# Assist Mode runtime files generated by `npm run build:assist-worker` / `build:assist-ocr`
public/models/assist-scene/scene-worker.js
public/models/assist-scene/frame-tape-worker.js
public/models/assist-scene/ort-wasm-*
public/models/assist-ocr/ocr-worker.js
public/models/assist-ocr/tesseract-worker.min.js
public/models/assist-ocr/core/
public/models/assist-ocr/lang/

# recommender evaluation snapshot (local export of public formations)
/.recsys-snapshot/

# DB backups hold member data: kept outside the repository
/backups/
/graft/
